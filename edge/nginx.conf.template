# Edge allowlist and authentication for everything reachable from the internet.
#
# This file is an envsubst *template*: the nginx image renders
# /etc/nginx/templates/*.template into /etc/nginx/conf.d/ at startup, so the
# shared secret lives in .env and never in a tracked file.
#
# Two layers, and both matter:
#
#   1. Authentication — one shared secret, accepted in either form:
#        Authorization: Bearer <BB_EDGE_TOKEN>     (machine clients)
#        Authorization: Basic  <base64 user:pass>  (browsers, via the prompt)
#      A browser cannot be told to send a bearer header from the address bar,
#      which is why both forms carry the same secret.
#
#   2. Allowlist — the origin still default-denies. Auth stops strangers; the
#      allowlist stops an authenticated caller from reaching things that were
#      never meant to be remote, like model deletion or settings writes.
#
# The tunnel points at this origin, never at app:8080 directly, so both layers
# hold even for a quick tunnel — which can filter neither paths nor headers.

# The credential strings below are longer than the default 64-byte bucket, and
# nginx refuses to start rather than truncating them.
map_hash_bucket_size 256;

# Valid credential forms. Anything else, including an absent header, is 0.
map $http_authorization $bb_auth_form {
    default                     0;
    "Bearer ${BB_EDGE_TOKEN}"   1;
    "Basic ${BB_EDGE_BASIC}"    1;
}

# Fail closed when the secret is unset. envsubst renders an empty
# BB_EDGE_TOKEN as the literal credential "Bearer ", which anyone could send —
# so an unset secret must reject everyone rather than admit them. The source
# carries a real variable because a bare literal is not a valid map source.
map "$request_method:${BB_EDGE_TOKEN}" $bb_secret_set {
    "~^[A-Z]+:$"  0;
    default       1;
}

# Authenticated only when the secret exists *and* the credential matched.
map "$bb_secret_set$bb_auth_form" $bb_auth {
    "11"     1;
    default  0;
}

server {
    listen 8081;
    server_name _;

    # Keep the origin quiet about what it is running.
    server_tokens off;

    # A body large enough for document ingestion, small enough that the
    # endpoint cannot be used to fill the disk.
    client_max_body_size 32m;
    client_body_timeout 60s;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    # ---- 401 handler ------------------------------------------------------
    # WWW-Authenticate is what makes a browser show a login prompt; without it
    # a human visiting the dashboard just sees a bare error.
    location @unauthorized {
        default_type application/json;
        add_header WWW-Authenticate 'Basic realm="Brown Bear", charset="UTF-8"' always;
        add_header X-Content-Type-Options nosniff always;
        return 401 '{"error":"unauthorized","detail":"Send Authorization: Bearer <token>, or sign in as user bb."}';
    }

    # ---- default: deny ----------------------------------------------------
    # Everything not named below lands here, authenticated or not: PUT
    # /api/settings, POST /api/tokens/aggregate, /metrics, and every Ollama
    # model-management route.
    location / {
        default_type application/json;
        return 403 '{"error":"not exposed","detail":"This path is not published through the tunnel."}';
    }

    # ---- public: liveness -------------------------------------------------
    # Deliberately unauthenticated so an external monitor can probe it.
    # Reveals nothing but whether the app is up.
    location = /api/health/live {
        limit_except GET { deny all; }
        proxy_pass http://app:8080/api/health/live;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts.conf;
    }

    # ---- public: design book (BB-109) -------------------------------------
    # The only unauthenticated route besides the liveness probe. It serves two
    # static Markdown documents rendered from a read-only mount and touches no
    # database, gateway or setting — so it publishes design values and nothing
    # about this instance, and cannot be used to probe whether the stack is up.
    #
    # Exact match plus a trailing-slash prefix, deliberately: a bare
    # `location /design` would also match /designsomething, which belongs in the
    # default deny.
    location = /design {
        limit_except GET { deny all; }
        proxy_pass http://app:8080/design;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts.conf;
    }

    location /design/ {
        limit_except GET { deny all; }
        proxy_pass http://app:8080/design/;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts.conf;
    }

    # ---- authenticated: context gateway (spec 005) ------------------------
    # Prompts in, cached answers and retrieved context out. Never public: this
    # carries the content of what is being asked.
    location /ext/ {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        # Spec 007 uploads. Must stay ABOVE the app's BB_MAX_UPLOAD_BYTES (50 MB)
        # or nginx rejects an oversized body with its own 413 before the app can
        # apply — and report — its own limit. The server-wide 32m still guards
        # every other route.
        client_max_body_size 52m;
        proxy_pass http://app:8080/ext/;
        include /etc/nginx/proxy_common.conf;
        # Embedding a large document runs a model.
        include /etc/nginx/proxy_timeouts_long.conf;
    }

    # ---- authenticated: file preview (spec 007) ---------------------------
    # The one route that serves uploaded bytes back to a browser INLINE rather
    # than as a download, so it is the one route that needs its own headers.
    #
    # The server block sets `X-Frame-Options DENY`, which refuses framing even
    # from the same origin — that would block the <iframe> the PDF preview
    # renders in. nginx `add_header` cannot be relaxed per-response, and
    # a DENY from here plus a SAMEORIGIN from the app would leave the browser
    # with two conflicting values and resolve to the stricter one. So this
    # location declares its own.
    #
    # CAUTION: `add_header` in a location REPLACES every inherited add_header
    # rather than merging with them. `nosniff` and `Referrer-Policy` are repeated
    # below for that reason — dropping them here would strip nosniff from exactly
    # the route that serves attacker-supplied bytes.
    #
    # Ahead of `location /ext/` because nginx evaluates regex locations before
    # prefix ones, so this wins for a preview URL and nothing else changes.
    location ~ ^/ext/files/[^/]+/preview$ {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        limit_except GET { deny all; }

        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options SAMEORIGIN always;

        proxy_pass http://app:8080$uri$is_args$args;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts.conf;
    }

    # ---- authenticated: dashboard pages (BB-104) --------------------------
    # Served by the Next.js frontend, not the app. The app still owns every
    # /api/* route below; only the HTML moved. No auth code was added to the
    # frontend — this edge remains the one boundary.
    location = / {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        limit_except GET { deny all; }
        proxy_pass http://web:3000;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts.conf;
    }

    # Dashboard pages served by Next.js. `graph` and `logs` are BB-301; both are
    # pages, not API routes — the data they render comes from /api/graph and
    # /api/logs, which are published separately above. `agents` is spec 008, and
    # reads /ext/agents, which the /ext/ location above already publishes.
    location ~ ^/(tokens|cache|collections|settings|graph|logs|files|agents)$ {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        limit_except GET { deny all; }
        proxy_pass http://web:3000$uri$is_args$args;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts.conf;
    }

    # The framework's asset prefix. Fixed by Next and not foldable into
    # /static/; without it every page renders unstyled and inert.
    location /_next/ {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        limit_except GET { deny all; }
        proxy_pass http://web:3000;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts.conf;
    }

    # ---- authenticated: API documentation (spec 006) ----------------------
    # Authenticated, not public like /design: this enumerates every published
    # endpoint, and an inventory describes the attack surface where design values
    # do not. Static — it renders the route contract and touches no service.
    location /api-doc/ {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        limit_except GET { deny all; }
        proxy_pass http://app:8080/api-doc/;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts.conf;
    }

    # ---- authenticated: read-only API the pages consume ------------------
    # GET only. The write paths (PUT /api/settings, POST
    # /api/tokens/aggregate) fall through to the default deny, so a remote
    # caller can read this stack's numbers but not reconfigure it.
    location ~ ^/api/(info|health|system|cache|collections|export)$ {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        limit_except GET { deny all; }
        proxy_pass http://app:8080$uri$is_args$args;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts.conf;
    }

    location = /api/settings {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        # Read the configuration remotely; change it only on the host.
        limit_except GET { deny all; }
        proxy_pass http://app:8080/api/settings;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts.conf;
    }

    location ~ ^/api/tokens/(summary|history|by-model|by-source|aggregation|savings)$ {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        limit_except GET { deny all; }
        proxy_pass http://app:8080$uri$is_args$args;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts.conf;
    }

    # ---- authenticated: memory graph (BB-301) -----------------------------
    # Two paths, one regex: the overview and a single node's neighbourhood. GET
    # only — the graph is a view of stored memory, and nothing here writes.
    location ~ ^/api/graph(/node)?$ {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        limit_except GET { deny all; }
        proxy_pass http://app:8080$uri$is_args$args;
        include /etc/nginx/proxy_common.conf;
        # Expanding a node runs a nearest-neighbour query against Chroma, which is
        # a vector search rather than a row lookup.
        include /etc/nginx/proxy_timeouts_long.conf;
    }

    location = /api/logs/recent {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        limit_except GET { deny all; }
        proxy_pass http://app:8080/api/logs/recent;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts.conf;
    }

    # ---- authenticated: log stream (BB-301) -------------------------------
    # Server-Sent Events. Two things make this work and both are easy to undo:
    #
    #   proxy_buffering off  — in proxy_common.conf. With buffering on, nginx holds
    #                          each event until its buffer fills, so a live stream
    #                          arrives in silent batches and looks broken.
    #   the long timeouts    — the app sends a heartbeat every 15s, comfortably
    #                          inside 600s, so an idle stream is never reaped.
    location = /api/logs/stream {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        limit_except GET { deny all; }
        proxy_pass http://app:8080/api/logs/stream;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts_long.conf;
    }

    # ---- authenticated: inference ----------------------------------------
    # Exactly the routes that *use* a model, named individually rather than as
    # /ollama/ so that pull, create, copy, push and delete stay denied — those
    # let a caller fill the disk or destroy pulled models.
    location = /ollama/api/chat {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        limit_except POST { deny all; }
        proxy_pass http://app:8080/ollama/api/chat;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts_long.conf;
    }

    location = /ollama/api/generate {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        limit_except POST { deny all; }
        proxy_pass http://app:8080/ollama/api/generate;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts_long.conf;
    }

    location = /ollama/api/embed {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        limit_except POST { deny all; }
        proxy_pass http://app:8080/ollama/api/embed;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts_long.conf;
    }

    location = /ollama/api/tags {
        error_page 401 = @unauthorized;
        if ($bb_auth = 0) { return 401; }
        limit_except GET { deny all; }
        proxy_pass http://app:8080/ollama/api/tags;
        include /etc/nginx/proxy_common.conf;
        include /etc/nginx/proxy_timeouts.conf;
    }
}
