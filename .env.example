# Reference for every credential this stack uses (roadmap F10).
#
# Caution: compose.yaml does NOT interpolate most of the keys below — it
# hardcodes them. Copying this file to .env therefore does not change Postgres,
# Redis or VectorAdmin; it only creates a file that disagrees with the running
# containers. Changing those means editing compose.yaml (and, for Postgres,
# recreating the volume, since the password is set at initialisation).
#
# Only these are interpolated from .env today:
#   CLOUDFLARE_TUNNEL_TOKEN, BB_EDGE_TOKEN, BB_EDGE_BASIC

# --- PostgreSQL ---
POSTGRES_USER=vectoradmin
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=vdbms

# --- Redis ---
REDIS_PASSWORD=change-me-strong

# --- VectorAdmin ---
JWT_SECRET=change-me-to-a-long-random-string
INNGEST_SIGNING_KEY=change-me
INNGEST_EVENT_KEY=background_workers

# --- Brown Bear app ---
# Dedicated database, separate from VectorAdmin's vdbms (roadmap D3).
BB_DATABASE_URL=postgresql+psycopg://vectoradmin:change-me-strong@postgres:5432/brownbear
BB_OLLAMA_URL=http://ollama:11434
BB_CHROMA_URL=http://chromadb:8000
BB_REDIS_URL=redis://:change-me-strong@redis:6379/0
BB_DEBUG=false

# --- Cloudflare tunnel ---
# Token for a named tunnel created in the Cloudflare Zero Trust dashboard.
# Point that tunnel's public hostname at http://edge:8081 — never at
# app:8080, which has no authentication and no path allowlist in front of it.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Edge authentication ---
# One shared secret guarding everything the tunnel publishes except the
# liveness probe. Accepted in two forms so both audiences work:
#   machines   Authorization: Bearer $BB_EDGE_TOKEN
#   browsers   login prompt — user "bb", the token as the password
#
# BB_EDGE_BASIC must be base64("bb:<BB_EDGE_TOKEN>"). Regenerate both together:
#   TOKEN=$(openssl rand -hex 32)
#   echo "BB_EDGE_TOKEN=$TOKEN"
#   echo "BB_EDGE_BASIC=$(printf 'bb:%s' "$TOKEN" | base64 -w0)"
#
# Left unset, the edge rejects every authenticated route rather than admitting
# anyone — see the fail-closed guard in edge/nginx.conf.template.
BB_EDGE_TOKEN=
BB_EDGE_BASIC=
